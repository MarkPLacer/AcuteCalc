<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unlocks 120 Hz ProMotion for CADisplayLink / MTKView on iPhone. iPad Pro has it by default. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Background App Refresh looks for a new build and posts a local notification (UpdateChecker).
	     AltStore and SideStore rename this with the bundle identifier, so the app reads it from here. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).update-check</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- The update popup offers the sideloading apps found on the device (SideloadManager).
	     altstore-classic, not altstore: AltStore PAL registers altstore too and cannot install the IPA. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>feather</string>
		<string>sidestore</string>
		<string>altstore-classic</string>
		<string>esign</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.markplacer.acutecalc.math</string>
			<key>UTTypeDescription</key>
			<string>Acute Calc Math</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>acutemath</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.markplacer.acutecalc</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>acutecalc</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Unlocks 120 Hz ProMotion for CADisplayLink / MTKView on iPhone. iPad Pro has it by default. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Background App Refresh looks for a new build and posts a local notification (UpdateChecker).
	     AltStore and SideStore rename this with the bundle identifier, so the app reads it from here. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).update-check</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- The launch screen in the calculator's background colour (LaunchBackground = systemBackground: white
	     in light, black in dark), so it matches the first screen in both appearances. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.markplacer.acutecalc.math</string>
			<key>UTTypeDescription</key>
			<string>Acute Calc Math</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>acutemath</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.markplacer.acutecalc</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>acutecalc</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
